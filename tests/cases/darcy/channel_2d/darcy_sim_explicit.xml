<?xml version="1.0" encoding="UTF-8" ?>
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 2 </Number_of_spatial_dimensions>
  <Number_of_time_steps> 30 </Number_of_time_steps>
  <Time_step_size> 0.001 </Time_step_size>
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 0 </Start_saving_after_time_step>

  <Increment_in_saving_restart_files> 5 </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 1 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 0 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh">
  <Mesh_file_path> explicit_mesh/volume.vtu </Mesh_file_path>
  <Domain_file_path> explicit_mesh/domain.dat </Domain_file_path>

  <Add_face name="left">
    <Face_file_path> explicit_mesh/mesh-surfaces/left.vtp </Face_file_path>
  </Add_face>

  <Add_face name="right">
    <Face_file_path> explicit_mesh/mesh-surfaces/right.vtp </Face_file_path>
  </Add_face>

  <Add_face name="bottom">
    <Face_file_path> explicit_mesh/mesh-surfaces/bottom.vtp </Face_file_path>
  </Add_face>

  <Add_face name="top">
    <Face_file_path> explicit_mesh/mesh-surfaces/top.vtp </Face_file_path>
  </Add_face>

  <Add_face name="channel">
    <Face_file_path> explicit_mesh/mesh-surfaces/channel.vtp </Face_file_path>
  </Add_face>
</Add_mesh>

<Add_equation type="darcy">
  <Coupled> false </Coupled>
  <Min_iterations> 2 </Min_iterations>
  <Max_iterations> 5 </Max_iterations>
  <Tolerance> 1e-6 </Tolerance>

  <Fluid_density> 1 </Fluid_density>
  <Conductivity> 1 </Conductivity>
  <Permeability> 1e-5 </Permeability>
  <Source_term> 0.0 </Source_term>

  <Domain id="1">
    <Equation> darcy </Equation>
    <Permeability> 1e-5 </Permeability>
    <Fluid_density> 1 </Fluid_density>
    <Source_term> 0.0 </Source_term>
  </Domain>

  <Output type="Spatial">
    <MBF> true </MBF>
    <MBF_flux> true </MBF_flux>
  </Output>

  <LS type="GMRES">
    <Linear_algebra type="fsils">
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
    <Tolerance> 1e-6 </Tolerance>
    <Max_iterations> 100 </Max_iterations>
    <Krylov_space_dimension> 50 </Krylov_space_dimension>
  </LS>

  <!-- Channel lumen: linearly ramp 0 -> 1 over [0, 0.02], then hold -->
  <Add_BC name="channel">
    <Type> Dirichlet </Type>
    <Time_dependence> Unsteady </Time_dependence>
    <Temporal_values_file_path> channel_pressure.dat </Temporal_values_file_path>
    <Ramp_function> true </Ramp_function>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>

  <!-- <Add_BC name="left">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC> -->

  <Add_BC name="right">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>

  <Add_BC name="bottom">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>

  <Add_BC name="top">
    <Type> Dirichlet </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> 0.0 </Value>
    <Zero_out_perimeter> false </Zero_out_perimeter>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
